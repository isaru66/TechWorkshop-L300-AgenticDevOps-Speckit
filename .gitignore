# Local environment and credentials. Example files must contain no secrets.
.env
.env.*
!.env.example
!.env.*.example
*.env
.envrc
.secrets/
secrets/
*.secret
credentials.json
*-credentials.json
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Java and Maven
target/
*.class
hs_err_pid*
replay_pid*

# Node.js
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python and uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Jekyll and Bundler output, not the source theme or configuration
/_site/
/.sass-cache/
/.jekyll-cache/
/.jekyll-metadata
/.bundle/
/vendor/bundle/

# Local editor and operating-system files
.idea/
.DS_Store
Thumbs.db
